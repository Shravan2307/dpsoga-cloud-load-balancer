{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedS3WorkloadAndResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET",
        "arn:aws:s3:::REPLACE_BUCKET/workloads/*",
        "arn:aws:s3:::REPLACE_BUCKET/models/*",
        "arn:aws:s3:::REPLACE_BUCKET/results/*",
        "arn:aws:s3:::REPLACE_BUCKET/reports/*"
      ]
    },
    {
      "Sid": "DescribeAndOptionallyScaleConfiguredECSService",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT:service/REPLACE_CLUSTER/REPLACE_SERVICE"
    },
    {
      "Sid": "PublishApplicationMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricData"],
      "Resource": "*"
    },
    {
      "Sid": "WriteContainerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:REPLACE_REGION:REPLACE_ACCOUNT:log-group/REPLACE_LOG_GROUP:*"
    }
  ]
}
