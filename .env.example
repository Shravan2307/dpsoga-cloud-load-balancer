API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
DATASET_PATH=
RESULTS_PATH=results
RANDOM_SEED=42
EXECUTION_MODE=simulation
INSTALL_AWS=0
AWS_REGION=
AWS_S3_BUCKET=
AWS_ECS_CLUSTER=
AWS_ECS_SERVICE=
AWS_DRY_RUN=true
MIN_CAPACITY=1
MAX_CAPACITY=20
SAFE_UTILIZATION=0.75
COOLDOWN_SECONDS=300
CLOUDWATCH_NAMESPACE=DPSOGA/Application

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dpsoga
DB_USER=dpsoga_admin
DB_PASSWORD=your_secure_password_here

# Google Cluster Trace Config
GOOGLE_TRACE_ENABLED=false
GOOGLE_TRACE_PATH=data/raw/google_cluster_trace/sample_task_usage.csv
TRACE_WINDOW_SECONDS=60
TRACE_REPLAY_SPEED=10
